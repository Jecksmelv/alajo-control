# Copy to .env (in this folder or ONE folder above it) and fill in.
# Alajo Control looks for .env in the project folder first, then in the parent folder,
# so a grader can keep a single .env in a shared submissions directory.

# Portkey gateway key used for all model calls (required for AI features).
PORTKEY_API_KEY=your-portkey-key-here

# Optional overrides
# ALAJO_MODEL=gpt-5.6-luna
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# PORTKEY_PROVIDER=openai
